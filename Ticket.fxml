<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sistematickets1.TicketController">
    <stylesheets>
        <URL value="@ticket.css"/>
    </stylesheets>
    <TextField fx:id="descripcionInput" promptText="Descripción del ticket" />
<HBox spacing="10">
    <Button text="Agregar Ticket" onAction="#onAgregarTicket" />
    <Button text="Atender Ticket" onAction="#onAtenderTicket" />
</HBox>

<Label text="Tickets pendientes:" />
<ListView fx:id="listaTickets" prefHeight="150" />

<Label fx:id="labelTicketActual" text="Ticket actual: Ninguno" />
<TextArea fx:id="descripcionArea" prefHeight="100" />

<HBox spacing="10">
    <Button text="Guardar Cambio" onAction="#onGuardarCambio" />
    <Button text="Deshacer Cambio" onAction="#onDeshacerCambio" />
</HBox>

</AnchorPane>
